# Required: provide an API key for at least one supported provider.
# Server-side only. Never use the NEXT_PUBLIC_ prefix for API keys.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional provider selection: gemini, openai, or custom.
# If multiple keys are configured, set AI_PROVIDER explicitly.
# AI_PROVIDER=gemini

# Gemini defaults are defined in src/lib/server/config.ts.
# Optional overrides:
# CHAT_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=3072

# OpenAI defaults are defined in src/lib/server/config.ts.
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512

# Best-effort in-memory rate limit per IP for AI endpoints.
# RATE_LIMIT_PER_MINUTE=30
