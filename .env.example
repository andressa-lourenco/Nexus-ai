# --- Required (Provide at least one) ----------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — it must not reach the browser.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Optional -------------------------------------------------------------
# Force provider if multiple keys are set: 'gemini' | 'openai' | 'custom'
# AI_PROVIDER=gemini

# For Gemini:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMENSIONS=768

# For OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512

# Requests per minute allowed per IP on the AI endpoints (best-effort, in-memory).
# RATE_LIMIT_PER_MINUTE=30

